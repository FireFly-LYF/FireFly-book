# 构建上下文：仓库根目录
# docker compose -f deploy/docker-compose.yml build web-console
FROM node:20-alpine AS build
WORKDIR /app
COPY web-console/package.json web-console/package-lock.json ./
RUN npm ci
COPY web-console/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-web-console.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80

# ai-services 本地环境（复制为 services-ai/.env；勿提交 .env）
# 与仓库根 .env 的 INTERNAL_HMAC_SECRET、RABBITMQ_PASSWORD 保持一致。

# ----- RabbitMQ（moderation）-----
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# ----- Java 内部 API（HMAC，不经 Gateway）-----
INTERNAL_HMAC_SECRET=
CONTENT_BASE_URL=http://127.0.0.1:9002
MEDIA_BASE_URL=http://127.0.0.1:9003
SEARCH_BASE_URL=http://127.0.0.1:9007

# ----- NSFW Detector（vxlink/nsfw_detector 容器）-----
NSFW_DETECTOR_URL=http://127.0.0.1:3333
NSFW_THRESHOLD=0.5
IMAGE_MODERATION_ENABLED=true
MAX_IMAGES_PER_NOTE=9

# ----- 各服务端口 -----
MODERATION_SERVICE_PORT=9101
ASSISTANT_SERVICE_PORT=9102

# ----- assistant-service：LLM（DashScope Qwen OpenAI 兼容）-----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=280
LLM_ENABLE_THINKING=false
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT_SEC=3

# ----- 日志 -----
LOG_LEVEL=INFO

# gRPC 下游测试服务
# 构建：docker compose build downstream-grpc

FROM golang:1.25-alpine AS builder
ENV GOPROXY=https://goproxy.cn,direct
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download
COPY gateway/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /downstream ./cmd/downstream_grpc

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /downstream /usr/local/bin/downstream
EXPOSE 50052
ENTRYPOINT ["downstream", "-port", "50052"]

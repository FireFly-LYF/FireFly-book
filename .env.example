# FireFly 本地密钥与可选部署变量（复制为 .env 后填写；勿提交 .env）
# 启动本机：.\start-all.ps1 会加载并校验「必填密钥」非空后注入子进程。
# 全栈容器：docker compose -f deploy/docker-compose.yml --env-file .env up -d --build
# 禁止在 application.yml / gateway.yaml 写默认密钥。

# ----- 必填密钥（无默认值，缺则启动失败）-----
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_PASSWORD=
INTERNAL_HMAC_SECRET=
MEDIA_SIGN_SECRET=
MYSQL_PASSWORD=
RABBITMQ_PASSWORD=

# ----- 可选：本机媒体目录（不设则用 %USERPROFILE%/FireFlyData/media）-----
# MEDIA_STORAGE_DIR=D:/FireFlyData/media
# MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8080/files

# ----- 可选：compose / 生产覆盖（不设则用 application-prod.yml 内 docker 默认主机名）-----
# RABBITMQ_USER=guest
# MYSQL_HOST=mysql
# RABBITMQ_HOST=rabbitmq
# REDIS_HOST=redis
# 连接池按实例覆盖（不设则用各服务 application.yml 默认）
# HIKARI_MAX_POOL=15
# HIKARI_MIN_IDLE=5
# ES_BASE_URL=http://elasticsearch:9200
# 换 IK mapping 后一次性 true 重建 notes/users，回填靠 MQ，然后改回 false
# ES_RECREATE_INDICES=false
# SERVER_ADDRESS=0.0.0.0
